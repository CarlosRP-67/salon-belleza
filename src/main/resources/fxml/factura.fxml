<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="root-dashboard" prefWidth="1020.0" prefHeight="720.0"
      minWidth="940.0" minHeight="640.0"
      stylesheets="@../css/factura.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.com.beauty.spa.salon.controller.FacturaController">

    <StackPane styleClass="header" minHeight="112.0" prefHeight="112.0" maxHeight="112.0">
        <ImageView fitHeight="112.0" preserveRatio="true" mouseTransparent="true"
                   StackPane.alignment="CENTER_RIGHT">
            <image>
                <Image url="@../images/banner.png"/>
            </image>
            <viewport>
                <Rectangle2D minX="0.0" minY="45.0" width="334.0" height="157.0"/>
            </viewport>
        </ImageView>

        <HBox alignment="CENTER_LEFT" spacing="18.0" pickOnBounds="false">
            <padding>
                <Insets top="0" right="28" bottom="0" left="30"/>
            </padding>
            <ImageView fitHeight="60.0" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/logo.png"/>
                </image>
            </ImageView>
            <VBox alignment="CENTER_LEFT" spacing="4.0">
                <Label text="Nueva Factura" styleClass="page-title"/>
                <Label text="B E L L E Z A   •   C U I D A D O   •   B I E N E S T A R"
                       styleClass="subtitle"/>
            </VBox>
        </HBox>
    </StackPane>

    <VBox styleClass="content-area" spacing="14.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="16" right="28" bottom="14" left="28"/>
        </padding>

        <HBox styleClass="card" alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets top="12" right="16" bottom="12" left="14"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <StackPane styleClass="icon-badge">
                    <Region styleClass="icon, icon-person"/>
                </StackPane>
                <Label text="Cliente:" styleClass="field-label"/>
            </HBox>
            <ComboBox fx:id="comboUsuarios" promptText="Seleccione un cliente..."
                      maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Nuevo cliente" styleClass="accent-button" onAction="#crearUsuarioRapido">
                <graphic>
                    <Region styleClass="icon, icon-plus-circle"/>
                </graphic>
            </Button>
        </HBox>

        <GridPane hgap="16.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" halignment="LEFT"/>
                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" halignment="LEFT"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" valignment="TOP"/>
            </rowConstraints>

            <VBox styleClass="card" spacing="12.0" GridPane.columnIndex="0" GridPane.rowIndex="0"
                  GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                <padding>
                    <Insets top="14" right="16" bottom="14" left="16"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ImageView fitHeight="26.0" preserveRatio="true" opacity="0.85">
                        <image>
                            <Image url="@../images/logo.png"/>
                        </image>
                    </ImageView>
                    <VBox spacing="3.0" alignment="CENTER_LEFT">
                        <Label text="Servicios disponibles" styleClass="card-title"/>
                        <Region styleClass="title-underline"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tablaServicios" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colServicioNombre" text="Servicio" prefWidth="260.0" minWidth="120.0"/>
                        <TableColumn fx:id="colServicioPrecio" text="Precio" prefWidth="110.0"
                                     minWidth="90.0" maxWidth="150.0" styleClass="col-right"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="6.0" styleClass="placeholder-box">
                            <ImageView fitHeight="38.0" preserveRatio="true" opacity="0.6">
                                <image>
                                    <Image url="@../images/logo.png"/>
                                </image>
                            </ImageView>
                            <Label text="Tabla sin contenido" styleClass="placeholder-title"/>
                            <Label text="No hay servicios activos para mostrar."
                                   styleClass="placeholder-text" wrapText="true"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0" minHeight="40.0" prefHeight="40.0">
                    <HBox styleClass="pill" alignment="CENTER_LEFT" spacing="8.0">
                        <Region styleClass="icon, icon-tag"/>
                        <Label text="Cantidad:" styleClass="field-label-soft"/>
                    </HBox>
                    <Spinner fx:id="spinnerCantidad" prefWidth="90.0" editable="true"/>
                    <Button text="Agregar &gt;&gt;" styleClass="primary-button" onAction="#agregarAlCarrito">
                        <graphic>
                            <Region styleClass="icon, icon-plus-circle"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <VBox styleClass="card" spacing="12.0" GridPane.columnIndex="1" GridPane.rowIndex="0"
                  GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                <padding>
                    <Insets top="14" right="16" bottom="14" left="16"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Region styleClass="icon, icon-cart, icon-title"/>
                    <VBox spacing="3.0" alignment="CENTER_LEFT">
                        <Label text="Servicios a facturar" styleClass="card-title"/>
                        <Region styleClass="title-underline"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tablaCarrito" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCarritoServicio" text="Servicio" prefWidth="200.0" minWidth="100.0"/>
                        <TableColumn fx:id="colCarritoCantidad" text="Cant." prefWidth="76.0"
                                     minWidth="72.0" maxWidth="90.0" styleClass="col-center"/>
                        <TableColumn fx:id="colCarritoPrecioUnit" text="Precio unit." prefWidth="112.0"
                                     minWidth="104.0" maxWidth="130.0" styleClass="col-right"/>
                        <TableColumn fx:id="colCarritoSubtotal" text="Subtotal" prefWidth="104.0"
                                     minWidth="94.0" maxWidth="130.0" styleClass="col-right"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="6.0" styleClass="placeholder-box">
                            <ImageView fitHeight="38.0" preserveRatio="true" opacity="0.6">
                                <image>
                                    <Image url="@../images/logo.png"/>
                                </image>
                            </ImageView>
                            <Label text="Tabla sin contenido" styleClass="placeholder-title"/>
                            <Label text="Agrega servicios desde la lista de disponibles."
                                   styleClass="placeholder-text" wrapText="true"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0" minHeight="40.0" prefHeight="40.0">
                    <Button text="Quitar seleccionado" styleClass="danger-button" onAction="#quitarDelCarrito">
                        <graphic>
                            <Region styleClass="icon, icon-trash"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </GridPane>
    </VBox>

    <StackPane styleClass="total-section" minHeight="84.0" prefHeight="84.0">
        <ImageView fitHeight="70.0" preserveRatio="true" opacity="0.55" mouseTransparent="true"
                   StackPane.alignment="BOTTOM_LEFT">
            <image>
                <Image url="@../images/decoracion.png"/>
            </image>
        </ImageView>

        <HBox alignment="CENTER_LEFT" spacing="14.0" pickOnBounds="false">
            <padding>
                <Insets top="12" right="28" bottom="12" left="78"/>
            </padding>
            <StackPane styleClass="icon-badge, icon-badge-rose">
                <Region styleClass="icon, icon-coins"/>
            </StackPane>
            <Label fx:id="lblTotal" text="Total: $0.00" styleClass="total-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Generar Factura" styleClass="primary-button, primary-button-large"
                    minWidth="-Infinity" onAction="#generarFactura">
                <graphic>
                    <Region styleClass="icon, icon-document"/>
                </graphic>
            </Button>
            <Button text="Volver al menú" styleClass="secondary-button, secondary-button-large"
                    minWidth="-Infinity" onAction="#volverAlMenu">
                <graphic>
                    <Region styleClass="icon, icon-menu"/>
                </graphic>
            </Button>
        </HBox>
    </StackPane>

</VBox>
