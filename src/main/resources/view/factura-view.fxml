<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.beauty.spa.salon.controller.FacturaController">
    <stylesheets>
        <URL value="@../css/empleado-styles.css" />
    </stylesheets>
    <children>
        <VBox spacing="10.0" style="-fx-padding: 15;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label styleClass="titulo-pantalla" text="Módulo de Facturación" />
                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="280.0" spacing="8.0">
                            <children>
                                <Label text="ID Cliente:" />
                                <TextField fx:id="txtIdCliente" promptText="ID del cliente" />
                                <Label text="Fecha Factura:" />
                                <DatePicker fx:id="dpFechaFactura" prefWidth="280.0" />
                                <Label text="Total:" />
                                <TextField fx:id="txtTotal" promptText="0.00" />
                                <HBox spacing="6.0" style="-fx-padding: 10 0 0 0;">
                                    <children>
                                        <Button fx:id="btnGenerar" onAction="#guardarFactura" styleClass="btn-primario" text="Generar" />
                                        <Button fx:id="btnLimpiar" onAction="#limpiarCampos" styleClass="btn-secundario" text="Limpiar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tblFacturas" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colIdFactura" prefWidth="80.0" text="ID Factura" />
                                        <TableColumn fx:id="colIdCliente" prefWidth="120.0" text="ID Cliente" />
                                        <TableColumn fx:id="colFechaFactura" prefWidth="150.0" text="Fecha Factura" />
                                        <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>