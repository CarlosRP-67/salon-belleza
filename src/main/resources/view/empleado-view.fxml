<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1160.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.beauty.spa.salon.controller.EmpleadoController">
    <stylesheets>
        <URL value="@../css/empleado-styles.css" />
    </stylesheets>
    <children>
        <VBox spacing="10.0" style="-fx-padding: 15;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
           <children>
              <Label styleClass="titulo-pantalla" text="Gestión de Empleados" />
              <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                 <children>
                    <VBox prefWidth="260.0" spacing="8.0">
                       <children>
                          <Label text="Usuario:" />
                          <ComboBox fx:id="cmbUsuario" prefWidth="260.0" promptText="Seleccione un usuario" />
                          <Label text="Especialidad:" />
                          <TextField fx:id="txtEspecialidad" />
                          <Label text="Teléfono:" />
                          <TextField fx:id="txtTelefono" />
                          <Label text="Horario de Trabajo:" />
                          <TextField fx:id="txtHorario" />
                          <HBox spacing="6.0">
                             <children>
                                <Button fx:id="btnGuardar" onAction="#guardarEmpleado" styleClass="btn-primario" text="Guardar" />
                                <Button fx:id="btnActualizar" onAction="#actualizarEmpleado" styleClass="btn-primario" text="Actualizar" />
                                <Button fx:id="btnEliminar" onAction="#eliminarEmpleado" styleClass="btn-secundario" text="Eliminar" />
                                <Button fx:id="btnLimpiar" onAction="#limpiarCampos" styleClass="btn-secundario" text="Limpiar" />
                             </children>
                          </HBox>
                       </children>
                    </VBox>
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                       <children>
                          <HBox alignment="CENTER_LEFT" spacing="10.0">
                             <children>
                                <Label text="Buscar:" />
                                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, especialidad o teléfono..." HBox.hgrow="ALWAYS" />
                             </children>
                          </HBox>
                          <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">
                             <columns>
                                <TableColumn fx:id="colIdEmpleado" prefWidth="86.0" text="ID Empleado" />
                                <TableColumn fx:id="colIdUsuario" text="ID Usuario" />
                                <TableColumn fx:id="colNombre" prefWidth="140.0" text="Nombre" />
                                <TableColumn fx:id="colEspecialidad" prefWidth="140.0" text="Especialidad" />
                                <TableColumn fx:id="colTelefono" prefWidth="124.0" text="Teléfono" />
                                <TableColumn fx:id="colHorario" prefWidth="168.0" text="Horario" />
                             </columns>
                          </TableView>
                       </children>
                    </VBox>
                 </children>
              </HBox>
           </children>
        </VBox>
    </children>
</AnchorPane>