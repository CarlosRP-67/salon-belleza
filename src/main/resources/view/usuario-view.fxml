<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="695.0" prefWidth="1140.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.beauty.spa.salon.controller.UsuarioController">
    <stylesheets>
        <URL value="@../css/empleado-styles.css" />
    </stylesheets>
    <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <Label styleClass="titulo-pantalla" text="Gestión de Usuarios" />
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefWidth="260.0" spacing="8.0">
                     <children>
                        <Label text="Nombre:" />
                        <TextField fx:id="txtNombre" />
                        <Label text="Apellido:" />
                        <TextField fx:id="txtApellido" />
                        <Label text="Nombre de Usuario:" />
                        <TextField fx:id="txtNombreUsuario" />
                        <Label text="Correo Electrónico:" />
                        <TextField fx:id="txtCorreo" />
                        <Label text="Contraseña (dejar en blanco para mantener):" />
                        <PasswordField fx:id="txtContrasena" />
                        <Label text="Rol de Sistema:" />
                        <ComboBox fx:id="cmbRol" prefWidth="260.0" promptText="Seleccione un Rol" />
                        <HBox spacing="6.0">
                           <children>
                              <Button fx:id="btnGuardar" onAction="#guardarUsuario" styleClass="btn-primario" text="Guardar" />
                              <Button fx:id="btnActualizar" onAction="#actualizarUsuario" styleClass="btn-primario" text="Actualizar" />
                              <Button fx:id="btnEliminar" onAction="#eliminarUsuario" styleClass="btn-secundario" text="Eliminar" />
                              <Button fx:id="btnLimpiar" onAction="#limpiarCampos" styleClass="btn-secundario" text="Limpiar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Buscar:" />
                              <TextField fx:id="txtBuscar" promptText="Buscar usuario por nombre, usuario o correo..." HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colIdUsuario" prefWidth="60.0" text="ID" />
                              <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                              <TableColumn fx:id="colApellido" prefWidth="120.0" text="Apellido" />
                              <TableColumn fx:id="colNombreUsuario" prefWidth="110.0" text="Usuario" />
                              <TableColumn fx:id="colCorreo" prefWidth="160.0" text="Correo" />
                              <TableColumn fx:id="colRol" prefWidth="80.0" text="ID Rol" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>