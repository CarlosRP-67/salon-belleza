<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" styleClass="root-pane"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.com.beauty.spa.salon.controller.MainMenuController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Salón de Belleza" styleClass="title-label"/>

    <Button fx:id="btnServicios" text="Gestionar Servicios (Administrador)"
            maxWidth="320" prefWidth="320" onAction="#irAServicios"/>

    <Button fx:id="btnFactura" text="Nueva Factura"
            maxWidth="320" prefWidth="320" onAction="#irAFactura"/>

</VBox>
