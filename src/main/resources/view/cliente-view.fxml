<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="695.0" prefWidth="1140.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.beauty.spa.salon.controller.ClienteController">
    <stylesheets>
        <URL value="@../css/empleado-styles.css" />
    </stylesheets>
    <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <Label styleClass="titulo-pantalla" text="Gestión de Clientes" />
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefWidth="260.0" spacing="8.0">
                     <children>
                        <Label text="Usuario:" />
                        <ComboBox fx:id="cmbUsuario" prefWidth="260.0" promptText="Seleccione un usuario" />
                        <Label text="Teléfono:" />
                        <TextField fx:id="txtTelefono" />
                        <Label text="Dirección:" />
                        <TextField fx:id="txtDireccion" />
                        <HBox spacing="6.0">
                           <children>
                              <Button fx:id="btnGuardar" onAction="#guardarCliente" styleClass="btn-primario" text="Guardar" />
                              <Button fx:id="btnActualizar" onAction="#actualizarCliente" styleClass="btn-primario" text="Actualizar" />
                              <Button fx:id="btnEliminar" onAction="#eliminarCliente" styleClass="btn-secundario" text="Eliminar" />
                              <Button fx:id="btnLimpiar" onAction="#limpiarCampos" styleClass="btn-secundario" text="Limpiar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Buscar:" />
                              <TextField fx:id="txtBuscar" promptText="Buscar cliente por nombre, teléfono o dirección..." HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colIdCliente" prefWidth="80.0" text="ID Cliente" />
                              <TableColumn fx:id="colIdUsuario" prefWidth="80.0" text="ID Usuario" />
                              <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
                              <TableColumn fx:id="colApellido" prefWidth="130.0" text="Apellido" />
                              <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono" />
                              <TableColumn fx:id="colDireccion" prefWidth="200.0" text="Dirección" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>