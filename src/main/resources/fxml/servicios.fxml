<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.com.beauty.spa.salon.controller.ServiciosController">

    <center>
        <VBox spacing="10" styleClass="root-pane">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label fx:id="lblTitulo" text="Servicios del Salón" styleClass="subtitle-label"/>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS" prefWidth="500" prefHeight="350">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción"/>
                    <TableColumn fx:id="colPrecio" text="Precio"/>
                    <TableColumn fx:id="colDuracion" text="Duración (min)"/>
                </columns>
            </TableView>
            <Button text="Volver al menú" onAction="#volverAlMenu"/>
        </VBox>
    </center>

    <right>
        <VBox spacing="15" prefWidth="280" styleClass="root-pane">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Crear nuevo servicio" styleClass="subtitle-label"/>
            <GridPane hgap="10" vgap="10">
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Descripción:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDescripcion" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Precio:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPrecio" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Duración:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDuracion" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <Button text="Guardar Servicio" styleClass="primary-button" onAction="#guardarServicio"/>
        </VBox>
    </right>

</BorderPane>
