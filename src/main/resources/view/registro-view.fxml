<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="850.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.beauty.spa.salon.controller.RegistroController">
   <children>
      <!-- HBox anclado a los 4 lados -->
      <HBox fx:id="rootContainer" prefHeight="500.0" prefWidth="850.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Panel Izquierdo: Banner responsivo por CSS (Ocupa 50% inicial y crece flexible) -->
            <StackPane fx:id="leftPane" prefHeight="500.0" prefWidth="425.0" styleClass="banner-container" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="BOTTOM_LEFT" prefHeight="500.0" prefWidth="425.0" spacing="5.0" styleClass="overlay-box">
                     <children>
                        <Label styleClass="banner-title" text="Great Spa" textFill="#0cae40" />
                        <Label styleClass="banner-subtitle" text="Registrate para gozar todos nuestro servivios!" textFill="#08caff" />
                     </children>
                  </VBox>
               </children>
            </StackPane>

            <!-- Panel Derecho: Formulario responsivo y centrado (Ocupa 50% inicial y crece flexible) -->
            <VBox fx:id="rightPane" alignment="CENTER" prefHeight="500.0" prefWidth="425.0" spacing="12.0" styleClass="form-container" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-label" text="Crear Cuenta" />
                  <Label styleClass="subtitulo-label" text="Completa tus datos para registrarte" />
                  
                  <TextField fx:id="txtNombre" maxWidth="400.0" prefHeight="38.0" promptText="Nombre" styleClass="text-field" />
                  <TextField fx:id="txtApellido" maxWidth="400.0" prefHeight="38.0" promptText="Apellido" styleClass="text-field" />
                  <TextField fx:id="txtNombreUsuario" maxWidth="400.0" prefHeight="38.0" promptText="Nombre de Usuario" styleClass="text-field" />
                  <TextField fx:id="txtCorreo" maxWidth="400.0" prefHeight="38.0" promptText="Correo Electrónico" styleClass="text-field" />
                  
                  <!-- Contenedor para la Contraseña -->
                  <StackPane alignment="CENTER_RIGHT" maxWidth="400.0">
                     <children>
                        <PasswordField fx:id="txtContrasena" prefHeight="38.0" promptText="Contraseña" styleClass="text-field" />
                        <TextField fx:id="txtContrasenaVisible" managed="false" maxWidth="400.0" prefHeight="38.0" promptText="Contraseña" styleClass="text-field" visible="false" />
                        <Button fx:id="btnTogglePassword" mnemonicParsing="false" onAction="#handleTogglePassword" styleClass="eye-button" text="👁" />
                     </children>
                  </StackPane>
                  
                  <ComboBox fx:id="cmbRol" maxWidth="400.0" prefHeight="38.0" promptText="Seleccione un Rol" styleClass="text-field" />
                  
                  <Button fx:id="btnRegistrar" maxWidth="400.0" mnemonicParsing="false" onAction="#handleRegistrar" prefHeight="38.0" styleClass="button-action" text="Registrarse" />
                  
                  <Button fx:id="btnRegresarLogin" mnemonicParsing="false" onAction="#handleRegresarLogin" styleClass="link-button" text="¿Ya tienes cuenta? Iniciar Sesión" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>