<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="695.0" prefWidth="1140.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.beauty.spa.salon.controller.ProductoController">
    <stylesheets>
        <URL value="@../css/empleado-styles.css" />
    </stylesheets>
    <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <Label styleClass="titulo-pantalla" text="Gestión de Productos" />
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefWidth="260.0" spacing="8.0">
                     <children>
                        <Label text="Nombre del Producto:" />
                        <TextField fx:id="txtNombre" />
                        <Label text="Descripción:" />
                        <TextField fx:id="txtDescripcion" />
                        <Label text="Precio:" />
                        <TextField fx:id="txtPrecio" promptText="0.00" />
                        <Label text="Stock Disponible:" />
                        <TextField fx:id="txtStock" promptText="0" />
                        <HBox spacing="6.0">
                           <children>
                              <Button fx:id="btnGuardar" onAction="#guardarProducto" styleClass="btn-primario" text="Guardar" />
                              <Button fx:id="btnActualizar" onAction="#actualizarProducto" styleClass="btn-primario" text="Actualizar" />
                              <Button fx:id="btnEliminar" onAction="#eliminarProducto" styleClass="btn-secundario" text="Eliminar" />
                              <Button fx:id="btnLimpiar" onAction="#limpiarCampos" styleClass="btn-secundario" text="Limpiar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Buscar:" />
                              <TextField fx:id="txtBuscar" promptText="Buscar por nombre o descripción..." HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colIdProducto" prefWidth="60.0" text="ID" />
                              <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                              <TableColumn fx:id="colDescripcion" prefWidth="220.0" text="Descripción" />
                              <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                              <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>