<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.beauty.spa.salon.controller.CitaController">
    <children>
        <VBox spacing="10.0" style="-fx-padding: 15;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label styleClass="titulo-pantalla" text="Gestión y Agenda de Citas" />
                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="280.0" spacing="8.0">
                            <children>
                                <Label text="Cliente (ID):" />
                                <TextField fx:id="txtIdCliente" promptText="ID del Cliente" />
                                <Label text="Empleado (ID):" />
                                <TextField fx:id="txtIdEmpleado" promptText="ID del Empleado" />
                                <Label text="Servicio (ID):" />
                                <TextField fx:id="txtIdServicio" promptText="ID del Servicio" />
                                <Label text="Fecha:" />
                                <DatePicker fx:id="dpFecha" prefWidth="280.0" />
                                <Label text="Hora (HH:MM):" />
                                <TextField fx:id="txtHora" promptText="Ej: 14:30" />
                                <Label text="Estado:" />
                                <ComboBox fx:id="cmbEstado" prefWidth="280.0" promptText="Seleccione Estado" />
                                <HBox spacing="6.0" style="-fx-padding: 10 0 0 0;">
                                    <children>
                                        <Button fx:id="btnGuardar" onAction="#guardarCita" styleClass="btn-primario" text="Agendar" />
                                        <Button fx:id="btnActualizar" onAction="#actualizarCita" styleClass="btn-primario" text="Actualizar" />
                                        <Button fx:id="btnEliminar" onAction="#eliminarCita" styleClass="btn-secundario" text="Cancelar" />
                                        <Button fx:id="btnLimpiar" onAction="#limpiarCampos" styleClass="btn-secundario" text="Limpiar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Buscar Cita:" />
                                        <TextField fx:id="txtBuscar" promptText="Buscar por ID o estado..." HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colIdCita" prefWidth="60.0" text="ID Cita" />
                                        <TableColumn fx:id="colIdCliente" prefWidth="100.0" text="ID Cliente" />
                                        <TableColumn fx:id="colIdEmpleado" prefWidth="100.0" text="ID Empleado" />
                                        <TableColumn fx:id="colIdServicio" prefWidth="100.0" text="ID Servicio" />
                                        <TableColumn fx:id="colFechaHora" prefWidth="180.0" text="Fecha y Hora" />
                                        <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>